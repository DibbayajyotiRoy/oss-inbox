# Jev Triage configuration. Copy to .env:  cp .env.example .env
# Every variable maps to backend/app/settings.py. docker-compose.yml overrides
# DATABASE_URL and REDIS_URL, so those two only matter for `make dev`.

# --- Decision backend -------------------------------------------------------
# "jev" (default): calibrated confidence from TypeSafe's Jev model.
# "anthropic": fallback when you have no TypeSafe key. Its confidences are
# UNCALIBRATED, so thresholds mean much less. The dashboard says so.
DECISION_BACKEND=jev

# Get a key at https://typesafe.ai (docs: https://docs.typesafe.ai).
TYPESAFE_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
# Pinned model version. A repo can override it with `model:` in .github/jev-triage.yml.
JEV_MODEL=jev-1.13.0

# Only used when DECISION_BACKEND=anthropic (uncalibrated).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Safety -----------------------------------------------------------------
# true = decisions and the actions they would take are recorded, but nothing is
# written to GitHub. Recommended for your first install.
DRY_RUN=true

# --- URLs -------------------------------------------------------------------
# PUBLIC_URL: where GitHub reaches the API (webhooks, setup callback).
# DASHBOARD_URL: where maintainers open the dashboard (OAuth callback).
PUBLIC_URL=http://localhost:8000
DASHBOARD_URL=http://localhost:3000

# Signs dashboard session cookies. Generate one:  openssl rand -hex 32
SESSION_SECRET=change-me

# --- Storage ----------------------------------------------------------------
POSTGRES_USER=jev
POSTGRES_PASSWORD=jev
POSTGRES_DB=jev
# `make dev` (backend on the host, postgres/redis in compose) uses these:
DATABASE_URL=postgresql://jev:jev@localhost:5432/jev
REDIS_URL=redis://localhost:6379/0

# Issues/PRs fetched per repo when you run an evaluation backfill.
BACKFILL_LIMIT=500
# Days to keep issue/PR text and the exact text sent to the decision backend. Older text is purged.
RETENTION_DAYS=365

# --- GitHub App -------------------------------------------------------------
# Leave these commented out. Open ${PUBLIC_URL}/api/setup once and the manifest
# flow appends them to this file for you (see docs/github-app.md for the manual route).
# An empty `GITHUB_APP_ID=` line here would shadow the values the setup page writes.
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_PRIVATE_KEY=       # PEM on one line, newlines written as \n
# GITHUB_WEBHOOK_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Local development only -------------------------------------------------
# Used by `make smee` to forward GitHub webhooks to localhost. https://smee.io/new
# SMEE_URL=https://smee.io/your-channel
